{
  "name": "html-color-picker",
  "version": "1.0.0",
  "description": "HTML Color Picker",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "setup": "npm ci",
    "build": "rolldown -c rolldown.config.ts --environment NODE_ENV:production",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.ts\" \"*.ts\"",
    "dev": "rolldown -c rolldown.config.ts --watch --environment NODE_ENV:development"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dli7319/html-color-picker.git"
  },
  "keywords": [],
  "author": "David Li",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dli7319/html-color-picker/issues"
  },
  "homepage": "https://github.com/dli7319/html-color-picker#readme",
  "dependencies": {
    "color-convert": "^3.1.3",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.9",
    "rolldown": "^1.2.12",
    "rollup-plugin-lit-css": "^6.0.1",
    "rollup-plugin-serve": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
